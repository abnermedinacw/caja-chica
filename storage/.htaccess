# Nadie debe poder pedir un archivo de storage/ por URL directa — los
# adjuntos SOLO deben servirse a través de descargarController.php, que
# valida sesión y que el archivo pertenezca al que lo pide. Sin esto,
# cualquiera que adivine o intercepte una ruta de storage/uploads/... se
# baja el comprobante de otro trabajador sin pasar por ningún login.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
