# config/database.php tiene el usuario y contraseña de la BBDD. Local no
# importa (root sin clave), pero en cPanel esas van a ser credenciales
# reales — esta carpeta no debe ser accesible por URL bajo ninguna
# circunstancia.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
